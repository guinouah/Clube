@model ModulePageViewModel
@{
    ViewData["Title"] = Model.Title;
    var columns = Model.Rows.FirstOrDefault()?.Keys.ToList() ?? new List<string>();
}
<div class="module-page-heading">
    <a class="back-link" asp-controller="Home" asp-action="Index">← Voltar à visão geral</a>
    <div class="module-heading-row"><span class="module-icon large">@Model.Icon</span><div><p class="eyebrow">@Model.Role</p><h1>@Model.Title</h1><p class="welcome-copy">@Model.Description</p></div></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="form-alert">@Model.Error</div> }
@if (TempData["Success"] is string success) { <div class="success-banner">@success</div> }
@if (TempData["Error"] is string actionError) { <div class="form-alert">@actionError</div> }
@if (Model.Rows.Count == 0) { <section class="empty-module-card"><div class="empty-module-mark">@Model.Icon</div><h2>Nenhum registro para mostrar</h2><p class="empty-module-copy">Quando houver dados oficiais no clube, eles aparecerão nesta lista.</p></section> }
else
{
    <div class="table-wrap"><table class="data-table"><thead><tr>@foreach (var column in columns) { <th>@column</th> }<th>Ações</th></tr></thead><tbody>
    @foreach (var row in Model.Rows) { <tr>@foreach (var column in columns) { <td>@row[column]</td> }
        @if (Model.Slug == "solicitacoes" && row.TryGetValue("Origem", out var source) && source == "Ingresso" && row.TryGetValue("ID", out var requestId))
        { <td><form asp-action="AvaliarIngresso" method="post" class="inline-actions"><input type="hidden" name="id" value="@requestId" /><button name="aprovar" value="true" class="small-action">Aprovar</button><button name="aprovar" value="false" class="small-action reject">Recusar</button></form></td> }
        else if (Model.Slug == "reservas" && row.TryGetValue("ID", out var reservationId) && row.TryGetValue("situacao", out var reservationStatus) && reservationStatus == "Pendente")
        { <td><form asp-action="AvaliarReserva" method="post" class="inline-actions"><input type="hidden" name="id" value="@reservationId" /><button name="aprovar" value="true" class="small-action">Aprovar</button><button name="aprovar" value="false" class="small-action reject">Recusar</button></form></td> }
        else if (Model.Slug == "mensalidades" && row.TryGetValue("ID", out var dueId) && row.TryGetValue("situacao", out var dueStatus) && dueStatus != "Paga")
        { <td><form asp-action="RegistrarPagamento" method="post"><input type="hidden" name="id" value="@dueId" /><button name="paga" value="true" class="small-action">Registrar paga</button></form></td> }
        else if (Model.Slug == "solicitacoes" && row.TryGetValue("Origem", out var serviceSource) && serviceSource == "Atendimento" && row.TryGetValue("ID", out var serviceId) && row.TryGetValue("situacao", out var serviceStatus) && serviceStatus != "Concluida")
        { <td><form asp-controller="AdminOperacoes" asp-action="AtualizarSolicitacao" method="post" class="inline-actions"><input type="hidden" name="id" value="@serviceId" /><button name="situacao" value="2" class="small-action">Em atendimento</button><button name="situacao" value="3" class="small-action">Concluir</button></form></td> }
        else { <td>—</td> }
    </tr> }
    </tbody></table></div>
    <p class="table-count">@Model.Rows.Count registro(s)</p>
}

@if (Model.Slug == "eventos")
{
    <section class="form-card module-form"><h2>Novo evento</h2><form asp-controller="AdminOperacoes" asp-action="CriarEvento" method="post"><label>Nome</label><input name="nome" required maxlength="160" /><label>Descrição</label><textarea name="descricao" maxlength="2000"></textarea><label>Início</label><input name="inicioUtc" type="datetime-local" required /><label>Término</label><input name="fimUtc" type="datetime-local" required /><label>Espaço reservado (opcional)</label><select name="espacoId"><option value="">Sem espaço vinculado</option>@foreach (var space in Model.Spaces ?? []) { <option value="@space.Id">@space.Nome</option> }</select><label>Local</label><input name="local" maxlength="160" /><label class="check-label"><input type="checkbox" name="publicoGeral" value="true" /> Aberto ao público</label><label class="check-label"><input type="checkbox" name="beneficente" value="true" /> Beneficente</label><button class="primary-button" type="submit">Salvar evento</button></form></section>
}
else if (Model.Slug == "espacos")
{
    <section class="form-card module-form"><h2>Novo espaço</h2><form asp-controller="AdminOperacoes" asp-action="CriarEspaco" method="post"><label>Nome</label><input name="nome" required maxlength="100" /><label>Descrição</label><textarea name="descricao" maxlength="1000"></textarea><button class="primary-button" type="submit">Salvar espaço</button></form></section>
}
else if (Model.Slug == "mensalidades")
{
    <section class="form-card module-form"><h2>Definir valor por categoria</h2><form asp-controller="AdminOperacoes" asp-action="DefinirValor" method="post"><label>Categoria</label><select name="categoria"><option value="1">Fundador associado</option><option value="2">Convidado</option><option value="3">Simpatizante</option></select><label>Valor mensal (R$)</label><input name="valor" type="number" step="0.01" min="0.01" required /><label>Vigente desde</label><input name="vigenteDesde" type="date" required /><button class="primary-button" type="submit">Salvar valor</button></form><h2>Gerar competências</h2><form asp-controller="AdminOperacoes" asp-action="GerarMensalidades" method="post"><label>Ano</label><input name="ano" type="number" min="2020" max="2100" value="@DateTime.Today.Year" required /><label>Mês</label><input name="mes" type="number" min="1" max="12" value="@DateTime.Today.Month" required /><label>Vencimento</label><input name="vencimento" type="date" required /><button class="primary-button" type="submit">Gerar mensalidades pendentes</button></form></section>
}
else if (Model.Slug == "associados")
{
    <section class="form-card module-form"><h2>Atribuir perfil</h2><p class="welcome-copy">Para novo acesso, defina uma senha temporária com pelo menos 12 caracteres. Presidente e tesoureiro têm acesso somente ao clube selecionado.</p><form asp-controller="AdminOperacoes" asp-action="AtribuirPerfil" method="post"><label>CPF</label><input name="cpf" required maxlength="14" /><label>Nome</label><input name="nome" required maxlength="160" /><label>E-mail</label><input name="email" type="email" maxlength="200" /><label>Senha temporária</label><input name="senha" type="password" minlength="12" /><label>Perfil</label><select name="perfil">@if (User.IsInRole("SuperAdmin")) { <option value="1">Presidente</option> }<option value="2">Tesoureiro</option><option value="3">Associado</option></select><button class="primary-button" type="submit">Salvar perfil</button></form></section>
}
