<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Projeto Clubes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Clubes.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{ var currentModule = Context.Request.RouteValues["id"]?.ToString(); }
    <div class="app-frame">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">C</span>
                <span><strong>clubes</strong><small>gestão conectada</small></span>
            </a>
            <div class="sidebar-caption">MENU PRINCIPAL</div>
            <nav class="side-nav" aria-label="Navegação principal">
                <a class="side-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index"><span>⌂</span> Visão geral</a>
                @if (User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "clubes" ? "active" : "")" asp-controller="ClubesAdmin" asp-action="Index"><span>♧</span> Clubes</a> }
                @if (User.IsInRole("Presidente") || User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "associados" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="associados"><span>♙</span> Associados</a> }
                @if (User.IsInRole("Presidente") || User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "solicitacoes" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="solicitacoes"><span>✉</span> Solicitações</a> }
                <div class="sidebar-caption section-gap">CLUBE</div>
                @if (User.IsInRole("Presidente") || User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "eventos" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="eventos"><span>✳</span> Eventos</a> }
                @if (User.IsInRole("Presidente") || User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "reservas" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="reservas"><span>▦</span> Reservas</a><a class="side-link @(currentModule == "espacos" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="espacos"><span>⌂</span> Espaços</a> }
                @if (User.IsInRole("Tesoureiro") || User.IsInRole("SuperAdmin")) { <a class="side-link @(currentModule == "mensalidades" ? "active" : "")" asp-controller="Home" asp-action="Module" asp-route-id="mensalidades"><span>R$</span> Mensalidades</a> }
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-note"><span class="note-dot"></span><div><strong>Área administrativa</strong><small>Dados isolados por clube</small></div></div>
                <small class="sidebar-version">Projeto Clubes · versão inicial</small>
            </div>
        </aside>

        <div class="main-column">
            <header class="topbar">
                <div class="topbar-context"><span class="topbar-label">PLATAFORMA DE CLUBES</span><span class="topbar-divider">/</span><span>@ViewData["Title"]</span></div>
                <div class="topbar-right"><span class="status-pulse"></span><span>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Ambiente local")</span>@if (User.Identity?.IsAuthenticated == true) { <form asp-controller="Conta" asp-action="Sair" method="post" class="logout-form"><button type="submit">Sair</button></form> }<span class="avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'C')</span></div>
            </header>
            <main class="page-content">
                @RenderBody()
            </main>
            <footer class="page-footer"><span>Projeto Clubes</span><span>Gestão com acesso seguro por clube</span></footer>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
